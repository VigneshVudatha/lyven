# ==============================================================================
# LYVEN E-COMMERCE CONFIGURATION (.env.example)
# Production-ready Next.js + Supabase PostgreSQL + Razorpay + Resend + WhatsApp
# ==============================================================================

# 1. Base URL (Use https://lyven.vercel.app for production or http://localhost:3000 for local dev)
NEXT_PUBLIC_BASE_URL=https://lyven.vercel.app

# 2. Supabase Configuration (PostgreSQL Database, Auth & Storage)
# Obtain from https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here
# Server-only Service Role Secret (NEVER expose to client, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-here

# 3. Razorpay Payment Gateway (Test Mode or Live Mode)
# Obtain from https://dashboard.razorpay.com/app/keys
# (Use rzp_test_... for development/testing, rzp_live_... for real customer payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
# Set this exact secret when configuring your Webhook in Razorpay Dashboard:
# Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# URL: https://lyven.vercel.app/api/payments/webhook
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# 4. WhatsApp Business Integration
# 10-digit Indian mobile number for direct WhatsApp customer support
NEXT_PUBLIC_WHATSAPP_NUMBER=6300107759

# 5. Admin Portal Security
# 32+ character high-entropy secret used for HMAC-SHA256 session token signatures
ADMIN_SECRET=lyven_super_secure_admin_jwt_secret_change_in_production
# Master password used to access /admin/login
ADMIN_PASSWORD=your_secure_admin_password_here

# 6. Transactional Order Email Notifications (Resend)
# Obtain your free API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Sender email address:
# - Default test address: 'LYVEN Orders <onboarding@resend.dev>'
# - Verified custom domain: 'LYVEN Orders <orders@lyven.in>'
NOTIFICATION_EMAIL_FROM=LYVEN Orders <onboarding@resend.dev>
# Admin alert recipient for all incoming orders:
ADMIN_NOTIFICATION_EMAIL=lyven.support1@gmail.com
