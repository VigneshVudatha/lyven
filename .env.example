# ==============================================================================
# LYVEN E-COMMERCE CONFIGURATION (.env.example)
# Production-ready Next.js + Supabase PostgreSQL + Razorpay + WhatsApp
# ==============================================================================

# 1. Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 2. Supabase Configuration (PostgreSQL Database, Auth & Storage)
# Obtain from https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here
# Server-only Service Role Secret (NEVER expose to client, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-here

# 3. Razorpay Payment Gateway (Test Mode / Production)
# Obtain from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# 4. WhatsApp Business Integration
# 10-digit Indian mobile number for direct WhatsApp customer support & custom studio enquiries
NEXT_PUBLIC_WHATSAPP_NUMBER=6300107759

# 5. Admin Portal Security
# 32+ character high-entropy secret used for HMAC-SHA256 session token signatures
ADMIN_SECRET=lyven_super_secure_admin_jwt_secret_change_in_production
# Master password used to access /admin/login
ADMIN_PASSWORD=your_secure_admin_password_here

# 6. Optional Transactional Email (Resend)
# Obtain from https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key_here
# NOTIFICATION_EMAIL_FROM=orders@lyven.in
# ADMIN_NOTIFICATION_EMAIL=vigneshvudatha7@gmail.com
